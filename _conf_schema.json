{
    "basic": {
        "description": "基础与访问控制",
        "hint": "白名单/黑名单、群聊 @ 触发、引用解析与防抖",
        "type": "object",
        "collapsed": false,
        "items": {
            "whitelist": {
                "description": "解析白名单",
                "hint": "请填写会话ID (可用命令sid查看), 一旦添加了白名单，则只有白名单会话发的链接会触发解析，优先级比黑名单高。留空表示不限制",
                "type": "list",
                "default": []
            },
            "blacklist": {
                "description": "解析黑名单",
                "hint": "请填写会话ID (可用命令sid查看), 黑名单会话发的链接不会触发解析。可在会话中使用命令 “开启解析” 和 “关闭解析” 来快捷设置",
                "type": "list",
                "default": []
            },
            "require_at_in_group": {
                "description": "群组消息必须@机器人",
                "hint": "QQ 官方群聊建议保持开启：只有@机器人的消息才会触发解析（官方通道不支持表情仲裁，多机器人同群请靠@区分）",
                "type": "bool",
                "default": true
            },
            "enable_reply_parse": {
                "description": "引用消息解析",
                "hint": "开启后，可通过引用包含链接的消息触发解析",
                "type": "bool",
                "default": false
            },
            "debounce_interval": {
                "description": "防抖秒数",
                "hint": "防抖机制：同一个会话下，防抖时间内不解析那些已经解析过的链接。设为 0 表示不启用防抖机制",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 600,
                    "step": 10
                },
                "default": 300
            }
        }
    },
    "media": {
        "description": "媒体与下载",
        "hint": "媒体大小/时长限制、发送方式、失败提示、下载超时与重试",
        "type": "object",
        "collapsed": false,
        "items": {
            "source_max_size": {
                "description": "资源最大大小",
                "hint": "允许下载的音视频最大体积，单位 MB",
                "type": "int",
                "slider": {
                    "min": 10,
                    "max": 500,
                    "step": 10
                },
                "default": 90
            },
            "source_max_minute": {
                "description": "资源最大时长（分钟）",
                "hint": "允许下载的音视频最大时长，超过则不解析",
                "type": "int",
                "slider": {
                    "min": 1,
                    "max": 60,
                    "step": 1
                },
                "default": 15
            },
            "audio_to_file": {
                "description": "音频以文件形式上传",
                "hint": "是否将解析到的音频文件用文件形式上传，而不是语音形式",
                "type": "bool",
                "default": true
            },
            "single_heavy_render_card": {
                "description": "单条重媒体仍渲染卡片",
                "hint": "重媒体是指：视频、音频、文件。重媒体下载和发送较为耗时，有需者可以打开此开关让插件先渲染一个信息卡片发出来，追求简洁者请不要开启",
                "type": "bool",
                "default": false
            },
            "forward_threshold": {
                "description": "分组阈值",
                "hint": "解析生成的消息条数达到此阈值时归入同一发送分组；QQ 官方不支持合并转发，该值仅影响分组策略，不会触发转发",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 10,
                    "step": 1
                },
                "default": 2
            },
            "show_download_fail_tip": {
                "description": "提示下载失败项",
                "hint": "关闭后将不再发送与下载失败相关的提示（如“此项媒体下载失败”、“超过文件大小限制”等）",
                "type": "bool",
                "default": true
            },
            "download_timeout": {
                "description": "下载请求超时秒数",
                "hint": "下载视频、音频等较大文件时的请求超时时间，单位秒。 建议设置大一点，视频、音频较大时下载耗时较长",
                "type": "int",
                "slider": {
                    "min": 10,
                    "max": 600,
                    "step": 10
                },
                "default": 280
            },
            "download_retry_times": {
                "description": "下载失败重试次数",
                "hint": "下载失败时，最多重试的次数",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 5,
                    "step": 1
                },
                "default": 2
            },
            "common_timeout": {
                "description": "普通请求超时时间",
                "hint": "普通请求超时时间，单位秒。用于一些普通的请求 ",
                "type": "int",
                "slider": {
                    "min": 5,
                    "max": 60,
                    "step": 1
                },
                "default": 15
            }
        }
    },
    "qq_send": {
        "description": "QQ 官方发送",
        "hint": "QQ 官方机器人的图集卡片、键盘、Markdown、引用回复、素材上传与回复溢出策略",
        "type": "object",
        "collapsed": false,
        "items": {
            "qq_gallery_render_card": {
                "description": "图集渲染为卡片",
                "hint": "QQ 官方单条消息只能发一张图，且单条被动消息回复次数有限。开启后图集会渲染为卡片（每卡最多 9 图），显著减少发送条数",
                "type": "bool",
                "default": true
            },
            "qq_card_max_images": {
                "description": "每张卡片最多图片数",
                "hint": "图集卡片每页最多展示的图片数量，建议 9（3x3 九宫格）。超过回复上限时会自动调整",
                "type": "int",
                "slider": {
                    "min": 1,
                    "max": 9,
                    "step": 1
                },
                "default": 9
            },
            "qq_reply_budget_override": {
                "description": "被动回复次数上限",
                "hint": "0 表示自动：私聊 4 次、群聊 5 次。若机器人是群主/管理员（可回复 50 次），可手动调大",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 50,
                    "step": 1
                },
                "default": 0
            },
            "qq_image_format": {
                "description": "图片发送格式",
                "hint": "发送原图前统一转换的格式，jpg/png 更稳妥；动图会取首帧",
                "type": "string",
                "options": [
                    "jpg",
                    "png"
                ],
                "labels": [
                    "JPEG",
                    "PNG"
                ],
                "default": "jpg"
            },
            "qq_native_card": {
                "description": "使用官方图文卡片",
                "hint": "能用公网封面+链接时，用官方图文卡片（msg_type=8）替代单作品 PIL 预览卡，可点击回到原内容；缺封面或非 https 链接时自动回退为渲染卡片",
                "type": "bool",
                "default": true
            },
            "qq_quote_reply": {
                "description": "发送时引用原消息",
                "hint": "解析结果以引用回复的形式发送，便于对照触发消息",
                "type": "bool",
                "default": false
            },
            "qq_keyboard": {
                "description": "发送内嵌键盘",
                "hint": "在解析结果上附加按钮（打开原链接 / 重新解析）。按钮交互回复走独立事件额度",
                "type": "bool",
                "default": true
            },
            "qq_keyboard_open_link": {
                "description": "键盘：打开原链接",
                "hint": "添加一个跳转到原内容的按钮（需要解析结果带有效链接）",
                "type": "bool",
                "default": true
            },
            "qq_keyboard_reparse": {
                "description": "键盘：重新解析",
                "hint": "添加一个回调按钮，点击后按原链接重新解析并发送",
                "type": "bool",
                "default": true
            },
            "qq_markdown": {
                "description": "Markdown 发送模式",
                "hint": "auto：有标题或链接时用 Markdown（可点击链接）；off：始终纯文本",
                "type": "string",
                "options": [
                    "auto",
                    "off"
                ],
                "labels": [
                    "自动",
                    "关闭"
                ],
                "default": "auto"
            },
            "qq_material_upload": {
                "description": "素材上传（Markdown 卡片）",
                "hint": "开启后会把渲染卡片上传到官方素材库（qqbot-media://），以 Markdown 图片形式发送，可与键盘组合；受 10MB / 100 张限制，失败自动回退为图片发送",
                "type": "bool",
                "default": false
            },
            "qq_overflow_mode": {
                "description": "超出回复额度时的投递方式",
                "hint": "off：直接省略；proactive：改用主动消息继续发送；private：群聊里改为私聊发送给触发者（需好友关系）。主动消息受官方频控（约 1000/天、20/分钟）及用户「允许主动发送」开关限制",
                "type": "string",
                "options": [
                    "off",
                    "proactive",
                    "private"
                ],
                "labels": [
                    "省略",
                    "主动消息",
                    "群转私聊"
                ],
                "default": "off"
            },
            "qq_overflow_limit": {
                "description": "溢出投递上限",
                "hint": "单次解析最多通过主动消息/私聊补发的消息条数，0 表示不补发",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 10,
                    "step": 1
                },
                "default": 3
            }
        }
    },
    "network": {
        "description": "网络与缓存",
        "hint": "下载代理与缓存自动清理",
        "type": "object",
        "collapsed": false,
        "items": {
            "proxy": {
                "description": "代理地址",
                "hint": "如 http://127.0.0.1:7890, 留空则直连。配置代理地址后, 请在各个解析器中再配置是否使用代理",
                "type": "string",
                "default": ""
            },
            "clean_cron": {
                "description": "自动清理缓存的触发周期",
                "hint": "使用 Cron 表达式（分 时 日 月 周）定义。例如：“30 2 * * *” 表示每天 2:30 。留空表示禁用自动清理",
                "type": "string",
                "default": "30 2 * * *"
            }
        }
    },
